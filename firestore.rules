rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public portfolio projects: anyone can read, client updates allowed
    match /projects/{projectId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Core Design Services (Capabilities & Specializations): anyone can read, updates allowed
    match /services/{serviceId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Verified Client Testimonials & Endorsements: anyone can read, updates allowed
    match /testimonials/{testimonialId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Global Site Settings & Branding
    match /siteSettings/{settingId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Complete Website Data Packs & Cloud Snapshots (One-Click Backup & Restore)
    match /datapacks/{packId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Hero backgrounds: anyone can read, client updates allowed
    match /heroBackgrounds/{bgId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Inquiries: visitors can create/submit, read/manage
    match /inquiries/{inquiryId} {
      allow read, create, update, delete: if true;
    }

    // Fallback default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

