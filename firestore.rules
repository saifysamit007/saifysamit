rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public portfolio projects: anyone can read, client updates allowed
    match /projects/{projectId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Hero backgrounds: anyone can read, client updates allowed
    match /heroBackgrounds/{bgId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Inquiries: visitors can create/submit, read/manage
    match /inquiries/{inquiryId} {
      allow read, create, update, delete: if true;
    }

    // Fallback default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
